<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test przekonań o pieniądzach</title>
<style>
  :root{
    --olive:#5F6B3E;
    --olive-dark:#3E451F;
    --terracotta:#B5603C;
    --terracotta-light:#D98F6C;
    --gold:#C79A3E;
    --cream:#FBF6EC;
    --box:#F4EFE2;
    --ink:#2E2A22;
    --line:#CBB98F;
    --muted:#7A7160;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  .wrap{
    max-width:720px;
    margin:0 auto;
    padding:36px 22px 80px;
  }
  h1,h2,h3{
    font-family:Georgia,'Iowan Old Style','Palatino Linotype',serif;
    color:var(--olive-dark);
    margin:0 0 8px 0;
    font-weight:700;
  }
  .eyebrow{
    font-size:11.5px;
    font-weight:700;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--terracotta);
    margin:0 0 10px 0;
  }
  .sub{
    font-family:Georgia,serif;
    font-style:italic;
    color:var(--terracotta);
    font-size:16px;
    margin:0 0 18px 0;
  }
  .rule{
    border:none;
    border-top:1px solid var(--gold);
    margin:16px 0 26px 0;
  }
  p{ line-height:1.6; font-size:15px; }
  .muted{ color:var(--muted); font-size:13.5px; line-height:1.55; }

  /* progress */
  .progress-track{
    position:sticky; top:0; z-index:10;
    background:var(--cream);
    padding-top:14px; padding-bottom:10px;
  }
  .progress-bar{
    height:4px; width:100%; background:var(--box);
    border-radius:4px; overflow:hidden;
  }
  .progress-fill{
    height:100%; background:var(--terracotta);
    transition:width .4s ease;
  }
  .progress-label{
    font-size:12px; color:var(--muted); margin-top:8px;
    display:flex; justify-content:space-between;
  }

  /* screens */
  .screen{ display:none; }
  .screen.active{ display:block; animation:fade .35s ease; }
  @keyframes fade{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  /* intro */
  .intro-orn{
    display:flex; justify-content:center; margin:28px 0 8px;
  }
  .intro-orn svg{ width:120px; height:120px; }
  .btn{
    display:inline-block;
    font-family:-apple-system,sans-serif;
    font-size:14.5px; font-weight:700;
    letter-spacing:.02em;
    padding:13px 26px;
    border-radius:2px;
    border:1.4px solid var(--olive-dark);
    background:var(--olive-dark);
    color:var(--cream);
    cursor:pointer;
    transition:background .2s,color .2s,transform .1s;
  }
  .btn:hover{ background:var(--olive); }
  .btn:active{ transform:scale(.98); }
  .btn.ghost{
    background:transparent; color:var(--olive-dark); border-color:var(--line);
  }
  .btn.ghost:hover{ background:var(--box); }
  .btn[disabled]{ opacity:.35; cursor:not-allowed; }
  .btn-row{ display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; }
  .btn-row.center{ justify-content:center; }

  .legend{
    text-align:center;
    font-weight:700; color:var(--terracotta);
    font-size:13.5px;
    background:var(--box);
    border:1px solid var(--line);
    border-radius:4px;
    padding:12px 14px;
    margin:18px 0;
  }

  /* statements */
  .cat-label{ font-size:11.5px; font-weight:700; letter-spacing:.1em;
    text-transform:uppercase; color:var(--terracotta); margin-bottom:4px; }
  .statement{
    margin:22px 0 22px 0;
    padding-bottom:18px;
    border-bottom:1px solid var(--line);
  }
  .statement:last-child{ border-bottom:none; }
  .statement p{ margin:0 0 12px 0; font-size:15px; }
  .scale{
    display:flex; gap:10px;
  }
  .scale button{
    flex:1;
    aspect-ratio:1;
    max-width:56px;
    border-radius:50%;
    border:1.6px solid var(--line);
    background:#fff;
    font-family:Georgia,serif;
    font-weight:700;
    font-size:16px;
    color:var(--olive-dark);
    cursor:pointer;
    transition:all .15s;
  }
  .scale button:hover{ border-color:var(--terracotta); }
  .scale button.selected{
    background:var(--terracotta);
    border-color:var(--terracotta);
    color:#fff;
    transform:scale(1.08);
  }
  .scale-caption{
    display:flex; justify-content:space-between;
    font-size:10.5px; color:var(--muted); margin-top:6px;
  }

  /* results */
  .score-hero{
    text-align:center;
    padding:22px 18px 26px;
    background:var(--box);
    border:1px solid var(--line);
    border-radius:6px;
    margin:18px 0 26px;
  }
  .score-hero .big{
    font-family:Georgia,serif; font-weight:700;
    font-size:52px; color:var(--olive-dark); line-height:1;
  }
  .score-hero .of{ font-size:16px; color:var(--muted); }

  .radar-wrap{ display:flex; justify-content:center; margin:20px 0 6px;}

  .cat-block{
    margin:26px 0; padding:18px 18px 6px;
    border:1px solid var(--line); border-radius:6px; background:#fff;
  }
  .cat-block h3{ font-size:17px; margin-bottom:2px; }
  .cat-score-row{
    display:flex; align-items:center; gap:10px; margin:8px 0 12px;
  }
  .bar-track{
    flex:1; height:9px; background:var(--box); border-radius:5px; overflow:hidden;
  }
  .bar-fill{ height:100%; background:var(--terracotta); border-radius:5px; }
  .cat-score-num{ font-weight:700; color:var(--olive-dark); font-size:13.5px; min-width:52px; text-align:right; }
  .tier-text{ font-size:14px; line-height:1.55; margin:6px 0 14px; }
  .tier-badge{
    display:inline-block; font-size:10.5px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; padding:3px 9px; border-radius:20px; margin-bottom:8px;
  }
  .tier-badge.low{ background:#E7EEDC; color:var(--olive-dark); }
  .tier-badge.mid{ background:#F3E6C9; color:#7A5A15; }
  .tier-badge.high{ background:#F1DACB; color:var(--terracotta); }

  .signals{ margin:8px 0 26px; }
  .signal-item{
    padding:12px 14px; margin-bottom:10px;
    background:var(--box); border-left:3px solid var(--terracotta);
    border-radius:0 4px 4px 0;
  }
  .signal-item .stmt{ font-weight:700; font-size:13.8px; margin-bottom:4px; }
  .signal-item .insight{ font-size:13.4px; color:var(--ink); line-height:1.5; }
  .signal-item .score-tag{
    display:inline-block; margin-left:6px; font-size:11px;
    color:var(--terracotta); font-weight:700;
  }

  .priority-list{ margin:0; padding:0; list-style:none; }
  .priority-list li{
    display:flex; align-items:baseline; gap:12px;
    padding:10px 0; border-bottom:1px solid var(--line);
  }
  .priority-list li:last-child{ border-bottom:none; }
  .priority-rank{
    font-family:Georgia,serif; font-weight:700; color:var(--terracotta);
    font-size:20px; min-width:26px;
  }

  .final-note{
    margin-top:30px; padding:16px 18px;
    border:1px dashed var(--line); border-radius:6px;
    font-size:13.8px; line-height:1.6; color:var(--ink); background:#fff;
  }

  footer{ text-align:center; color:var(--muted); font-size:11.5px; margin-top:50px; }

  @media print{
    .no-print{ display:none !important; }
    body{ background:#fff; }
    .screen{ display:none !important; }
    .screen.active{ display:block !important; }
  }

  @media (max-width:420px){
    .scale button{ font-size:13px; }
    .score-hero .big{ font-size:42px; }
  }
</style>
</head>
