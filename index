];

const OVERALL_BANDS = [
  {max:70, text:"Twoja relacja z pieniędzmi jest dziś stosunkowo spokojna i elastyczna, ograniczające przekonania rzadko przejmują u Ciebie kontrolę. To nie znaczy, że nie ma nic do zrobienia, ale pracujesz dziś z solidnego, stabilnego fundamentu."},
  {max:110, text:"Masz mieszaną relację z pieniędzmi, w części obszarów czujesz swobodę, w innych wciąż pojawia się silne napięcie. To bardzo częsty, „ludzki” wynik: nikt nie ma jednej, jednorodnej relacji z pieniędzmi we wszystkich obszarach życia naraz."},
  {max:150, text:"Ograniczające przekonania o pieniądzach są dziś bardzo aktywne i prawdopodobnie kosztują Cię sporo codziennej energii. To nie powód do niepokoju, to bardzo uczciwy, konkretny punkt wyjścia do pracy, którą teraz widzisz czarno na białym."}
];

/* =========================================================
   STATE
   ========================================================= */
const answers = {}; // key: "catIndex-stmtIndex" -> 1..5
let currentStep = 0; // 0..4 = category steps

/* =========================================================
   BUILD QUIZ STEPS
   ========================================================= */
const stepsContainer = document.getElementById('quiz-steps');

CATEGORIES.forEach((cat, ci)=>{
  const div = document.createElement('div');
  div.className = 'screen';
  div.id = 'screen-step-'+ci;

  let html = `<div class="cat-label">Obszar ${cat.no} · 6 stwierdzeń</div><h2>${cat.title}</h2><hr class="rule">`;

  cat.statements.forEach((s, si)=>{
    const id = ci+'-'+si;
    html += `
      <div class="statement">
        <p>${s.t}</p>
        <div class="scale" data-id="${id}">
          ${[1,2,3,4,5].map(v=>`<button type="button" onclick="selectAnswer('${id}',${v},this)">${v}</button>`).join('')}
        </div>
      </div>`;
  });

  html += `<div class="btn-row">
      ${ci>0 ? `<button class="btn ghost" onclick="goStep(${ci-1})">← Wstecz</button>` : ''}
      <button class="btn" id="next-${ci}" onclick="goStep(${ci+1})" disabled>${ci<4 ? 'Dalej →' : 'Zobacz wynik →'}</button>
    </div>`;

  div.innerHTML = html;
  stepsContainer.appendChild(div);
});

/* =========================================================
   NAVIGATION
   ========================================================= */
function startQuiz(){
  document.getElementById('screen-intro').classList.remove('active');
  document.getElementById('progressTrack').style.display='block';
  goStep(0);
}

function selectAnswer(id, value, btn){
  answers[id] = value;
  const group = btn.parentElement;
  [...group.children].forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  checkStepComplete(parseInt(id.split('-')[0]));
}

function checkStepComplete(ci){
  const need = CATEGORIES[ci].statements.length;
  let count = 0;
  for(let si=0; si<need; si++){
    if(answers[ci+'-'+si] !== undefined) count++;
  }
  const btn = document.getElementById('next-'+ci);
  if(btn) btn.disabled = (count < need);
}

function goStep(n){
  document.querySelectorAll('#quiz-steps .screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-results').classList.remove('active');

  if(n >= CATEGORIES.length){
    renderResults();
    document.getElementById('screen-results').classList.add('active');
    document.getElementById('progressTrack').style.display='none';
    window.scrollTo({top:0,behavior:'smooth'});
    return;
  }
  currentStep = n;
  document.getElementById('screen-step-'+n).classList.add('active');
  checkStepComplete(n);
  updateProgress(n);
  window.scrollTo({top:0,behavior:'smooth'});
}

function updateProgress(n){
  const pct = Math.round(((n)/CATEGORIES.length)*100);
  document.getElementById('progressFill').style.width = pct+'%';
  document.getElementById('progressLabel').textContent = `Obszar ${n+1} / ${CATEGORIES.length}`;
  document.getElementById('progressPct').textContent = pct+'%';
}

/* =========================================================
   SCORING + RESULTS
   ========================================================= */
function getCategoryScore(ci){
  const cat = CATEGORIES[ci];
  let sum = 0;
  cat.statements.forEach((s,si)=>{ sum += (answers[ci+'-'+si] || 0); });
  return sum;
}

function getTier(cat, score){
  for(const t of cat.tiers){ if(score <= t.max) return t; }
  return cat.tiers[cat.tiers.length-1];
}

function polar(cx,cy,r,angleDeg){
  const rad = (angleDeg-90) * Math.PI/180;
  return [cx + r*Math.cos(rad), cy + r*Math.sin(rad)];
}

function buildRadar(scores){
  const cx=150, cy=150, maxR=120, minR=18;
  const n = scores.length;
  const angleStep = 360/n;

  let gridRings = [0.25,0.5,0.75,1].map(f=>{
    const pts = scores.map((_,i)=>{
      const r = minR + (maxR-minR)*f;
      return polar(cx,cy,r,i*angleStep).join(',');
    }).join(' ');
    return `<polygon points="${pts}" fill="none" stroke="#CBB98F" stroke-width="0.6" opacity="0.6"/>`;
  }).join('');

  let axes = scores.map((_,i)=>{
    const [x,y] = polar(cx,cy,maxR,i*angleStep);
    return `<line x1="${cx}" y1="${cy}" x2="${x}" y2="${y}" stroke="#CBB98F" stroke-width="0.6" opacity="0.6"/>`;
  }).join('');

  let dataPts = scores.map((s,i)=>{
    const frac = (s-6)/(30-6); // normalize 6..30 -> 0..1
    const r = minR + (maxR-minR)*Math.max(frac,0.04);
    return polar(cx,cy,r,i*angleStep);
  });
  let dataPoly = dataPts.map(p=>p.join(',')).join(' ');

  let dots = dataPts.map(p=>`<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="#B5603C"/>`).join('');

  let labels = CATEGORIES.map((c,i)=>{
    const [x,y] = polar(cx,cy,maxR+26,i*angleStep);
    return `<text x="${x}" y="${y}" text-anchor="middle" dominant-baseline="middle"
      font-family="Georgia,serif" font-weight="700" font-size="13" fill="#3E451F">${c.no}</text>`;
  }).join('');

  return `<svg viewBox="0 0 300 300" width="300" height="300">
    <circle cx="${cx}" cy="${cy}" r="${minR}" fill="none" stroke="#C79A3E" stroke-width="1"/>
    ${gridRings}
    ${axes}
    <polygon points="${dataPoly}" fill="#B5603C" fill-opacity="0.28" stroke="#B5603C" stroke-width="2"/>
    ${dots}
    <text x="${cx}" y="${cy+5}" text-anchor="middle" font-family="Georgia,serif" font-style="italic" font-size="20" fill="#5F6B3E">$</text>
    ${labels}
  </svg>`;
}

function renderResults(){
  const scores = CATEGORIES.map((c,ci)=>getCategoryScore(ci));
  const total = scores.reduce((a,b)=>a+b,0);

  const overall = OVERALL_BANDS.find(b=>total<=b.max) || OVERALL_BANDS[OVERALL_BANDS.length-1];

  // ranking (highest score = most work needed) - descending
  const ranking = CATEGORIES.map((c,ci)=>({ci, title:c.title, score:scores[ci]}))
    .sort((a,b)=>b.score-a.score);

  // signals: statements scored >=4
  let signals = [];
  CATEGORIES.forEach((cat,ci)=>{
    cat.statements.forEach((s,si)=>{
      const v = answers[ci+'-'+si];
      if(v>=4){ signals.push({t:s.t, i:s.i, v, cat:cat.title}); }
    });
  });
  signals.sort((a,b)=>b.v-a.v);

  let html = `
    <div class="eyebrow">Twój wynik</div>
    <h1 style="font-size:28px;">Twoja mapa relacji<br>z pieniędzmi</h1>
    <p class="sub">Interpretacja oparta na Twoich konkretnych odpowiedziach</p>
    <hr class="rule">

    <div class="score-hero">
      <div class="big">${total}</div>
      <div class="of">z 150 punktów</div>
    </div>
    <p>${overall.text}</p>

    <div class="radar-wrap">${buildRadar(scores)}</div>
    <p class="muted" style="text-align:center;">Im dalej wierzchołek od środka, tym silniej ograniczające
    przekonania są aktywne w danym obszarze.</p>
  `;

  html += `<h2 style="margin-top:34px;">Szczegółowo, obszar po obszarze</h2>`;

  CATEGORIES.forEach((cat, ci)=>{
    const score = scores[ci];
    const tier = getTier(cat, score);
    const pct = Math.round(((score-6)/24)*100);
    html += `
      <div class="cat-block">
        <div class="cat-label">Obszar ${cat.no}</div>
        <h3>${cat.title}</h3>
        <div class="cat-score-row">
          <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
          <div class="cat-score-num">${score} / 30</div>
        </div>
        <span class="tier-badge ${tier.cls}">wynik ${tier.label}</span>
        <p class="tier-text">${tier.text}</p>
      </div>`;
  });

  if(signals.length){
    html += `<h2 style="margin-top:34px;">Twoje najsilniejsze sygnały</h2>
      <p class="muted">Stwierdzenia, które zaznaczyłaś jako „bardzo mnie dotyczy” lub bliskie temu,
      z dedykowanym, bardziej osobistym komentarzem do każdego z nich.</p>
      <div class="signals">`;
    signals.slice(0,10).forEach(s=>{
      html += `<div class="signal-item">
        <div class="stmt">${s.t}<span class="score-tag">${s.v}/5</span></div>
        <div class="insight">${s.i}</div>
      </div>`;
    });
    html += `</div>`;
    if(signals.length>10){
      html += `<p class="muted">...i ${signals.length-10} więcej stwierdzeń z wysoką oceną, im więcej ich
      zaznaczyłaś, tym więcej materiału do pracy masz dziś na talerzu (to dobra wiadomość, nie zła).</p>`;
    }
  } else {
    html += `<h2 style="margin-top:34px;">Twoje najsilniejsze sygnały</h2>
      <p>Żadne stwierdzenie nie zebrało u Ciebie wysokiej oceny, to znak, że dziś nie masz silnie
      aktywnych, dominujących blokad w żadnym z obszarów. Warto mimo to zerknąć na obszar z najwyższym
      wynikiem poniżej.</p>`;
  }

  html += `<h2 style="margin-top:34px;">Kolejność, w której warto pracować</h2>
    <p class="muted">Od obszaru, który dziś najbardziej „woła” o uwagę, do tego, który jest już
    najbardziej uporządkowany.</p>
    <ol class="priority-list">`;
  ranking.forEach((r,idx)=>{
    html += `<li><span class="priority-rank">${idx+1}</span><span>${r.title} - <b>${r.score}/30</b></span></li>`;
  });
  html += `</ol>`;

  const top = ranking[0];
  html += `<div class="final-note">
    <b>Twój priorytet numer jeden: „${top.title}”.</b> To obszar, w którym ograniczające przekonania są
    dziś najbardziej aktywne i najbardziej „słyszalne”, naturalne miejsce, od którego warto zacząć
    dalszą pracę. Warto powtórzyć ten test za 2–3 miesiące, żeby zobaczyć, jak zmienia się Twoja mapa.
  </div>`;

  html += `<div class="btn-row center no-print">
    <button class="btn" onclick="downloadResults()">Zapisz wynik jako plik</button>
    <button class="btn ghost" onclick="restartQuiz()">Zacznij od nowa</button>
  </div>`;

  document.getElementById('screen-results').innerHTML = html;
}

function downloadResults(){
  try{
    const src = document.getElementById('screen-results');
    const clone = src.cloneNode(true);
    clone.querySelectorAll('.no-print').forEach(el=>el.remove());
    const styleTag = document.querySelector('style').outerHTML;
    const now = new Date();
    const dateStr = now.toLocaleDateString('pl-PL');

    const docHtml = `<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wynik - Test przekonań o pieniądzach</title>
${styleTag}
</head>
<body>
<div class="wrap">
  <p class="muted" style="margin-bottom:0;">Wynik zapisany: ${dateStr}</p>
  <div class="screen active">${clone.innerHTML}</div>
</div>
</body>
</html>`;

    const blob = new Blob([docHtml], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'wynik-test-przekonan-o-pieniadzach.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(()=>URL.revokeObjectURL(url), 2000);
  }catch(err){
    alert('Nie udało się zapisać pliku automatycznie. Możesz zaznaczyć wynik na stronie i skopiować go ręcznie (Ctrl+A, Ctrl+C), albo zrobić zrzut ekranu.');
    console.error(err);
  }
}

function restartQuiz(){
  for(const k in answers){ delete answers[k]; }
  document.querySelectorAll('.scale button.selected').forEach(b=>b.classList.remove('selected'));
  document.querySelectorAll('[id^="next-"]').forEach(b=>b.disabled=true);
  document.getElementById('screen-results').classList.remove('active');
  document.getElementById('progressTrack').style.display='none';
  document.getElementById('screen-intro').classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body>
</html>
